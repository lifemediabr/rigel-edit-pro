# Copie para .env e preencha NO SERVIDOR (nunca mande senhas no chat)
DOMINIO=rigel.orionplayout.live
# usuários: nome:senha separados por vírgula. Cada um configura a PRÓPRIA chave de IA no painel.
RIGEL_USUARIOS=kennedy:troque-esta-senha,carlos:outra-senha
# texto aleatório longo e fixo (mantém o login depois de reiniciar)
RIGEL_SEGREDO=troque-por-um-texto-aleatorio-longo
# tiny | base | small | medium  (small = bom equilíbrio em CPU)
WHISPER_MODELO=small
RIGEL_HTTPS=1
